2.	Write a C program that contains a string (char pointer) with a value “Hello world”. The program should AND or and XOR each character in this string with 127 and display the result.



#include <stdio.h>
#include <string.h>

int main()
{
    char str[] = "Hello World";
    char str1[12];
    char str2[12];
    char str3[12];
    int i, len;

    len = strlen(str);

    for(i = 0; i < len; i++)
    {
        str1[i] = str[i] & 127;
        printf("%c", str1[i]);
    }
    str1[len] = '\0';

    printf("\n");

for(i = 0; i < len; i++)
    {
        str2[i] = str[i] | 127;
        printf("%c", str2[i]);
    }
    str2[len] = '\0';

    printf("\n");

    for(i = 0; i < len; i++)
    {
        str3[i] = str[i] ^ 127;
        printf("%c", str3[i]);
    }
    str3[len] = '\0';

    return 0;
}
